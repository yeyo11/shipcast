{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    // Start's compiler relies on dropping imports only used by server code; verbatim syntax keeps them
    "verbatimModuleSyntax": false
  },
  "include": ["src", "test", "vite.config.ts", "server.ts"]
}
