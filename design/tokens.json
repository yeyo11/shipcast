{
  "$description": "Shipcast design tokens, direction Cartel. Night is the default. tokens.css mirrors these values; scripts/contrast.mjs checks both agree and that every pair passes WCAG AA.",
  "color": {
    "night": {
      "ground": "#141413",
      "raised": "#1F1F1D",
      "black": "#000000",
      "on-black": "#F4F2EC",
      "hairline": "#33322F",
      "rail": "#76746D",
      "text": "#F4F2EC",
      "muted": "#A9A69E",
      "yellow": "#FFD43B",
      "on-yellow": "#000000",
      "cream": "#FFF8DC",
      "failure": "#FF6B5B",
      "success": "#6FD58E"
    },
    "day": {
      "ground": "#FFFFFF",
      "raised": "#EDEEF0",
      "black": "#000000",
      "on-black": "#F4F2EC",
      "hairline": "#D6D5D1",
      "rail": "#7A7872",
      "text": "#0D0D0D",
      "muted": "#5A5852",
      "yellow": "#FFD43B",
      "on-yellow": "#000000",
      "cream": "#FFF8DC",
      "failure": "#B42318",
      "success": "#157A3E"
    }
  },
  "font": {
    "display": "Phudu",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "type": {
    "display-xl": { "size": 150, "weight": 900, "lineHeight": 0.9, "letterSpacing": "-0.035em", "case": "upper" },
    "display": { "size": 96, "weight": 900, "lineHeight": 0.9, "letterSpacing": "-0.035em", "case": "upper" },
    "heading": { "size": 48, "weight": 900, "lineHeight": 0.92, "letterSpacing": "-0.03em", "case": "upper" },
    "title": { "size": 30, "weight": 700, "lineHeight": 0.95, "letterSpacing": "-0.02em", "case": "upper" },
    "body-lg": { "size": 20, "weight": 400, "lineHeight": 1.5, "letterSpacing": "-0.01em" },
    "body": { "size": 16, "weight": 400, "lineHeight": 1.5, "letterSpacing": "-0.005em" },
    "label": { "size": 14, "weight": 600, "lineHeight": 1.3 }
  },
  "radius": { "pill": 160, "band": 30, "card": 24, "chip": 12 },
  "border": { "card": 2.5, "control": 1.5 },
  "shadow": { "stamp": "4px 4px 0", "stamp-lg": "10px 10px 0" },
  "space": { "unit": 8, "section": 120, "band-padding": 64 },
  "motion": { "press": "80ms", "fade": "120ms" }
}
