# Copy to .env and fill in what the phase you are running needs. .env is gitignored; never commit a
# token. A network or source without its variables is left out; `pnpm shipcast status` lists what is on.

# GitHub, one token per brand: both are user accounts, so the engine polls each one for releases.
# Fine-grained: read-only on contents and metadata of the repos to watch, plus read and write on
# contents and pull requests of the launches repo. The MVP uses only the personal brand.
GITHUB_TOKEN_PERSONAL=
# GITHUB_TOKEN_COMPANY=

# claudio, the AI provider (https://github.com/yeyo11/claudio), run by docker-compose.yml. Shipcast's
# own names, not claudio's CLAUDIO_API_*: claudio exports those to the sessions it runs, which would
# point a Shipcast started from claudio at the wrong server. The token
# is also the instance's owner token: make one with `openssl rand -hex 32` before `docker compose up`.
SHIPCAST_CLAUDIO_URL=http://localhost:8798
SHIPCAST_CLAUDIO_TOKEN=
# CLAUDIO_PORT=8798

# dev.to (phase 1): Settings > Extensions > DEV Community API Keys.
DEVTO_API_KEY=

# Bluesky: Settings > Privacy and security > App passwords. Never the account password.
BLUESKY_HANDLE=yeyo11.bsky.social
BLUESKY_APP_PASSWORD=

# Mastodon: Preferences > Development > New application, scopes write:statuses and write:media.
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Instagram, through the Instagram API with Instagram Login: a professional (Creator or Business)
# account and the owner's Meta app with instagram_business_basic and
# instagram_business_content_publish. The app id is public; generate the token in the app dashboard
# (Instagram > API setup with Instagram login). It lasts 60 days and is refreshed with
# GET graph.instagram.com/refresh_access_token, which needs no app secret. The user id is read with it.
INSTAGRAM_APP_ID=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# The newsletter, sent through Brevo: Settings > SMTP & API > API keys. The sender and the list of
# each language are public and live in the launches repo's brand.yml (newsletter:).
BREVO_API_KEY=

# Blog visits, from Cloudflare Web Analytics through the GraphQL API: a token with
# Account > Account Analytics > Read, the account id, and the site tag (Web Analytics > the site >
# Manage site; not the beacon token). Without them the blog's visits are not read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=

# Google search numbers, from Search Console: the JSON key of a service account added as a user of
# the site's domain property (sc-domain:<site's host>). Keep the file outside the repo.
GOOGLE_SERVICE_ACCOUNT_FILE=

# The launches repo this engine writes drafts to; its brand.yml says which brand it speaks for.
SHIPCAST_LAUNCHES_REPO=yeyo11/launches
# The Postgres the launch registry lives in: the `postgres` service of docker-compose.yml
# (`docker compose up -d postgres`), whose credentials come from POSTGRES_USER, POSTGRES_PASSWORD
# and POSTGRES_DB below, or any other Postgres. Its migrations run when the app or the CLI starts.
SHIPCAST_DATABASE_URL=postgres://shipcast:shipcast@127.0.0.1:5433/shipcast
# The compose service's credentials and port, used when its volume is first created; keep them in
# step with SHIPCAST_DATABASE_URL. It listens on loopback only.
# POSTGRES_USER=shipcast
# POSTGRES_PASSWORD=shipcast
# POSTGRES_DB=shipcast
# POSTGRES_PORT=5433
# Files kept on this machine, such as the app's TLS certificate (gitignored). Defaults to ./data.
# SHIPCAST_DATA_DIR=./data
# Spend ceiling for one generation, in dollars.
# SHIPCAST_MAX_BUDGET_USD=5

# The web app (`pnpm app`): launches, channels, drafts and articles, on a domain of yours reachable
# only over your tailnet. Point an A record of that domain at this machine's tailnet address.
SHIPCAST_PUBLIC_URL=https://shipcast.example.dev
# A GitHub OAuth App (Settings > Developer settings > OAuth Apps) with the callback
# <SHIPCAST_PUBLIC_URL>/auth/github/callback; only these logins (comma-separated) get in.
SHIPCAST_GITHUB_CLIENT_ID=
SHIPCAST_GITHUB_CLIENT_SECRET=
SHIPCAST_ALLOWED_GITHUB=
# The certificate for that domain, from Let's Encrypt through the DNS challenge: a Cloudflare token
# with Zone > DNS > Edit on its zone. Without it the app serves plain HTTP on 127.0.0.1.
SHIPCAST_TLS_CLOUDFLARE_TOKEN=
# Where the app listens (Tailscale Serve forwards the tailnet's port 443 here; off to skip that).
# SHIPCAST_APP_HOST=127.0.0.1
# SHIPCAST_APP_PORT=8744
# SHIPCAST_APP_TAILSCALE=off
# Instagram Login from the Channels page: the Instagram app secret, beside INSTAGRAM_APP_ID above,
# with <SHIPCAST_PUBLIC_URL>/auth/instagram/callback listed in the Meta app's business login settings.
INSTAGRAM_APP_SECRET=
# The brand .env speaks for; accounts connected in the app win over it. Defaults to personal.
# SHIPCAST_ENV_BRAND=personal

# Phase 5 channels, also connectable from the app's Channels page.
# HASHNODE_TOKEN=
# HASHNODE_PUBLICATION_HOST=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_CHAT_ID=
# DISCORD_WEBHOOK_URL=
