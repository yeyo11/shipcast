# Copy to .env and fill in what the phase you are running needs. .env is gitignored; never commit a
# token. The names are provisional until the engine reads them (phase 1).

# GitHub, one token per brand: both are user accounts, so the engine polls each one for releases.
# Fine-grained, read-only on contents and metadata of the repos to watch.
# GITHUB_TOKEN_PERSONAL=
# GITHUB_TOKEN_COMPANY=

# claudio, the AI provider (https://github.com/yeyo11/claudio): its API URL and, when its auth is on,
# a token.
# CLAUDIO_API_URL=http://localhost:8797
# CLAUDIO_API_TOKEN=

# dev.to (phase 1): Settings > Extensions > DEV Community API Keys.
# DEVTO_API_KEY=
