# Copy to .env. .env is gitignored; never commit a token.
#
# .env holds only the bootstrap: what Shipcast needs before anyone signs in. Everything else (the
# launches repo, claudio's URL and token, the AI budget, the Instagram app) is set in the app's
# Settings page, kept in the database and the keychain; the networks' accounts are connected in the
# Channels page. See docs/decisions/github-app.md and docs/web-app.md.

# The Postgres the launch registry lives in: the `postgres` service of docker-compose.yml
# (`docker compose up -d postgres`), whose credentials come from POSTGRES_USER, POSTGRES_PASSWORD
# and POSTGRES_DB below, or any other Postgres. Its migrations run when the app or the CLI starts.
SHIPCAST_DATABASE_URL=postgres://shipcast:shipcast@127.0.0.1:5433/shipcast
# The compose service's credentials and port, used when its volume is first created; keep them in
# step with SHIPCAST_DATABASE_URL. It listens on loopback only.
# POSTGRES_USER=shipcast
# POSTGRES_PASSWORD=shipcast
# POSTGRES_DB=shipcast
# POSTGRES_PORT=5433
# Files kept on this machine, such as the app's TLS certificate (gitignored). Defaults to ./data.
# SHIPCAST_DATA_DIR=./data
# The keychain's service name; another one keeps a second install's secrets (or a test copy's) apart.
# SHIPCAST_KEYCHAIN_SERVICE=shipcast
# On a server, which has no desktop keychain: the secrets in an encrypted file, <data dir>/secrets.enc,
# under a key kept here and nowhere else (openssl rand -base64 32). scripts/keychain-to-file.ts moves a
# desktop install's keychain into one (docs/server.md).
# SHIPCAST_SECRET_STORE=file
# SHIPCAST_SECRETS_KEY=

# The GitHub App: sign-in, and everything the engine does on GitHub (reading repos and releases,
# committing drafts and opening their pull requests in the launches repo, merging), as the App's
# bot, <slug>[bot]. Permissions: Contents, Pull requests and Discussions read and write, Metadata
# read; events Release, Pull request, Repository, Push; callback
# <SHIPCAST_PUBLIC_URL>/auth/github/callback; webhook <SHIPCAST_PUBLIC_URL>/api/github/webhook.
# Install it on the account that owns the launches repo and the repos you launch.
SHIPCAST_GITHUB_APP_ID=
SHIPCAST_GITHUB_APP_SLUG=
SHIPCAST_GITHUB_APP_CLIENT_ID=
SHIPCAST_GITHUB_APP_CLIENT_SECRET=
SHIPCAST_GITHUB_APP_WEBHOOK_SECRET=
# The private key GitHub generated for the App (a .pem), relative to the repo's root; keep it in
# data/, which is gitignored. Or SHIPCAST_GITHUB_APP_PRIVATE_KEY with the PEM inline (\n for newlines).
SHIPCAST_GITHUB_APP_PRIVATE_KEY_FILE=data/github-app.pem
# Only these GitHub logins (comma-separated) get in; the first is the owner.
SHIPCAST_ALLOWED_GITHUB=

# The web app (`pnpm app`) on a domain of yours reachable only over your tailnet. Point an A record
# of that domain at this machine's tailnet address.
SHIPCAST_PUBLIC_URL=https://shipcast.example.dev
# The certificate for that domain, from Let's Encrypt through the DNS challenge: a Cloudflare token
# with Zone > DNS > Edit on its zone. Without it the app serves plain HTTP on 127.0.0.1.
SHIPCAST_TLS_CLOUDFLARE_TOKEN=
# Where the app listens (Tailscale Serve forwards the tailnet's port 443 here; off to skip that).
# SHIPCAST_APP_HOST=127.0.0.1
# SHIPCAST_APP_PORT=8744
# Behind a reverse proxy that does TLS (a server: docs/server.md): plain HTTP on SHIPCAST_APP_HOST,
# SHIPCAST_PUBLIC_URL outside, no certificate and no Tailscale Serve. The container image sets it.
# SHIPCAST_APP_TLS=proxy
# SHIPCAST_APP_TAILSCALE=off
# A preview copy beside the real app: plain HTTP on 127.0.0.1, no certificate read, issued or written.
# SHIPCAST_APP_TLS=off

# claudio, the AI provider (https://github.com/yeyo11/claudio), run by docker-compose.yml: Shipcast
# reads its URL and token from the settings (Settings page), but docker compose starts claudio with
# SHIPCAST_CLAUDIO_TOKEN from this file as the instance's owner token, so while compose runs claudio
# keep it here too (`openssl rand -hex 32`), the same value as in Settings.
# SHIPCAST_CLAUDIO_TOKEN=
# CLAUDIO_PORT=8798

# --- Fallbacks for an install from before the GitHub App and the Settings page ---
#
# Without the GitHub App: the OAuth App the owner signed in with, and the fine-grained token the
# engine ran on. With the App none of them is used: delete them (the App reads a repo's traffic
# too, through its Administration: read).
# SHIPCAST_GITHUB_CLIENT_ID=
# SHIPCAST_GITHUB_CLIENT_SECRET=
# GITHUB_TOKEN_PERSONAL=
#
# Settings that used to live here. Any of them still set is copied into the settings (secrets into
# the keychain) the first time the app or the CLI starts, once, and stays a fallback until removed.
# SHIPCAST_LAUNCHES_REPO=yeyo11/launches
# SHIPCAST_CLAUDIO_URL=http://localhost:8798
# SHIPCAST_MAX_BUDGET_USD=5
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
#
# The networks' credentials from before the Channels page: the fallback for the brand .env speaks
# for (SHIPCAST_ENV_BRAND, personal by default) and what Channels > Import from .env moves into the
# keychain. Connect accounts in the app instead.
# DEVTO_API_KEY=
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# MASTODON_INSTANCE=
# MASTODON_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# BREVO_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=
# GOOGLE_SERVICE_ACCOUNT_FILE=
# HASHNODE_TOKEN=
# HASHNODE_PUBLICATION_HOST=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# SHIPCAST_ENV_BRAND=personal
