{
  "name": "shipcast",
  "private": true,
  "version": "0.2.0",
  "description": "Launch your GitHub projects: on each release, analyse the repo with Claude, generate the launch content and publish it per channel after your approval",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && pnpm deps",
    "deps": "depcruise packages apps --config .dependency-cruiser.cjs --output-type err",
    "test": "pnpm -r test",
    "shipcast": "node apps/cli/src/main.ts",
    "app": "pnpm --filter @shipcast/web build && node apps/web/main.ts",
    "app:dev": "pnpm --filter @shipcast/web dev",
    "sqlite-to-postgres": "node scripts/sqlite-to-postgres.ts",
    "illustrations:specimen": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/illustrations-specimen.tsx"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
